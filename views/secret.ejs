<!-- views/index.ejs -->
<!DOCTYPE html>
<html>
<head>
  <title><%= title %></title>
</head>
<body>
  <h1>The Fight Club</h1>
  <h2> The quotes : " We don't talk about it " is in which rule </h2>
  <%- include("partials/errors.ejs") %>
  <p> Name: <%= user.firstName %> <%= user.lastName %> Email: <%= user.email %> </p>
  <p> Verify: <%= user.status %> </p>
  <form action="/secret" method="POST">

    <label for="answer">Your answer: </label>
    <input type="answer" name="answer" id="answer" required>

    <label for="admin">Admin </label>
    <input type="checkbox" name="admin" id="admin">

    <button type="submit">Submit</button>
  </form>

  <a href="/">Go back</a>
  
</body>
</html>
